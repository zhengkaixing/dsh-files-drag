{
  "name": "dsh-files-drag",
  "version": "1.1.0",
  "description": "Drag files straight out of DeepSeek Harness's built-in workspace file panel into the composer, and copy their absolute paths from the draft.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "drag-and-drop",
    "file-tree",
    "composer"
  ],
  "author": "zhengkaixing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengkaixing/dsh-files-drag.git"
  },
  "homepage": "https://github.com/zhengkaixing/dsh-files-drag",
  "engines": {
    "node": ">=20"
  }
}
